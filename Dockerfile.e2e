# E2E test runner: a real Home Assistant instance (docker-compose.e2e.yml)
# driven through a real browser. A separate image from any unit-test setup,
# because this one needs a browser runtime (~2 GB) that the fast HA-free unit
# tests must never depend on.
#
# The base image ships the browser binaries; requirements_e2e.txt pins
# `playwright==1.47.0` to EXACTLY this image tag, so `pip install` can never
# resolve a driver newer than the bundled browsers (a mismatch fails with a
# headless-shell error that looks like an app regression). `playwright install`
# is still run so the deps are present for the pinned version.
FROM mcr.microsoft.com/playwright/python:v1.47.0-jammy

WORKDIR /workspace
ENV PYTHONPATH=/workspace

COPY requirements_e2e.txt .
RUN pip install --no-cache-dir -r requirements_e2e.txt \
    && playwright install --with-deps chromium

COPY custom_components/ custom_components/
COPY scripts/e2e_bootstrap.py scripts/e2e_bootstrap.py
COPY tests_e2e/ tests_e2e/
# Shipped dashboard examples are test artifacts, not docs: REQ-HOM-126 renders
# examples/dashboard-labs-card.yaml in a real Lovelace dashboard.
COPY examples/ examples/

ENTRYPOINT ["pytest"]
CMD ["tests_e2e/", "-v", "--output=test-results", "--tracing=retain-on-failure"]
